# Local Diary — example environment file (synthetic values only).
# Copy to .env and adjust locally. The real .env is git-ignored and must
# never contain real diary content or secrets in tracked files.

# Application bind address / port (localhost by default).
APP_HOST=127.0.0.1
APP_PORT=8000

# Default application timezone (IANA name); validated at settings load.
APP_TIMEZONE=Europe/Moscow

# Maximum length of a text diary message body (Task 05).
APP_MAX_MESSAGE_LENGTH=20000

# Voice messages (Task 07): maximum upload size in MiB and the accepted
# MIME types. The list value is parsed as JSON, e.g.
#   APP_ALLOWED_AUDIO_MIME_TYPES=["audio/webm","audio/ogg","audio/wav"]
# Only types with a built-in safe storage profile are usable (see
# diary.domain.audio.service); unknown entries are rejected at upload time.
APP_MAX_AUDIO_MB=25
# APP_ALLOWED_AUDIO_MIME_TYPES=

# Durable job queue / worker policy (Task 08, ADR-003).
# job_max_attempts — maximum executions per job before it is marked failed.
# job_backoff_base_s / job_backoff_multiplier / job_max_backoff_s — exponential
#   backoff before a retry: delay = base * multiplier ** (attempt-1), capped at
#   max_backoff. The first retry waits base seconds, the second base*multiplier,
#   and so on.
# job_stale_after_s — a 'running' job untouched for longer than this is treated
#   as abandoned by a crashed worker and reclaimed (worker --reset-stale).
APP_JOB_MAX_ATTEMPTS=3
APP_JOB_BACKOFF_BASE_S=2
APP_JOB_BACKOFF_MULTIPLIER=2
APP_JOB_MAX_BACKOFF_S=300
APP_JOB_STALE_AFTER_S=300

# Normalization pipeline (Task 13): maximum number of original-export entries
# sent to the model in one LLM request. Longer exports are split into
# deterministic chunks of at most this size and merged back in order.
APP_NORMALIZE_CHUNK_ENTRIES=25

# Summarization pipeline (Task 14): context handling of the normalized
# document. Both values are measured in characters of the normalized entry
# text (entries themselves are never split).
# APP_SUMMARIZE_MAPREDUCE_THRESHOLD — a normalized document at most this long
#   is summarized in one single-pass request; a longer one switches to
#   map-reduce (one request per chunk, deterministic merge afterwards).
# APP_SUMMARIZE_CHUNK_SIZE — maximum size of one map-reduce input chunk.
APP_SUMMARIZE_MAPREDUCE_THRESHOLD=20000
APP_SUMMARIZE_CHUNK_SIZE=10000

# Wellbeing analysis (layer 4, Task 15). Set to false to disable the whole
# feature: new runs are rejected with a clear error and the UI hides the run
# action. Previously created reports stay readable.
APP_WELLBEING_ENABLED=true

# Temp-dir cleanup (Task 18): `python -m diary.cli backup --clean-temp`
# removes files inside APP_TEMP_DIR older than this many seconds. Only the
# temp directory is ever cleaned — audio, exports, backups and the database
# are never touched automatically.
APP_TEMP_RETENTION_S=86400

# Data root and directories. Defaults: <repo>/data and its subdirectories
# db/, audio/, exports/, temp/, backups/ and models/nli/. Only directories
# that no source sets follow APP_DATA_ROOT: a directory set here (or given as
# a constructor argument) keeps exactly the value it was given, even when the
# value equals the default. Override only what you need.
# APP_DATA_ROOT=
# APP_DB_DIR=
# APP_AUDIO_DIR=
# APP_EXPORTS_DIR=
# APP_TEMP_DIR=
# APP_BACKUPS_DIR=

# NLI cross-encoder used by the summary validation (T24): the directory where
# scripts/fetch-nli-model.sh puts the pinned weights (model.onnx,
# tokenizer.json, config.json — the weights never live in the repository).
# APP_NLI_MODEL_DIR=
# An empty APP_NLI_MODEL_SHA256 disables the pin, which is only useful while
# measuring a different conversion; the default is the pinned one.
# APP_NLI_MODEL_SHA256=

# Path to the real per-user model configuration YAML
# (default: <repo>/configs/models.yaml). See configs/models.example.yaml.
# MODELS_CONFIG=

# Example secret placeholders — configuration references secrets by variable
# NAME (api_key_env), never by value. Set real values only in the local .env.
# Transcription (faster_whisper) needs no key. OpenAI-compatible profiles
# require their referenced variables to be present and non-empty.
# NORMALIZATION_API_KEY=
# SUMMARIZATION_API_KEY=
# WELLBEING_API_KEY=

# GigaAM-v2 CTC+LM transcription backend (T44): the runtime lives in its own
# virtualenv outside the repository and is driven as a sidecar process, so the
# application needs to know where that interpreter is. These are machine
# paths, not decoding parameters: everything else (model_id, revision,
# beam_width, alpha/beta, chunking) belongs to `profiles.transcription` in the
# models config, and the backend is chosen there by `provider:` — setting these
# variables does not switch anything on its own. With APP_GIGAAM_PYTHON unset
# (or pointing at a path that does not exist) a GigaAM transcription fails with
# a clear "runtime is not provisioned" error instead of falling back to
# Whisper. Sidecar provisioning itself is T45; the weights are never downloaded
# by a transcription request.
# APP_GIGAAM_PYTHON=
# Worker script of the sidecar (default: <repo>/scripts/gigaam-stt-worker.py).
# APP_GIGAAM_WORKER_SCRIPT=
# One sidecar invocation may take this long before it is killed and the attempt
# fails as a transient error. Basis — measured 2026-09-23 on the 332 s
# recording at 20 s chunks (docs/stt-backends-analysis.md §6.5): model load
# 15.9–25.6 s (4 runs) plus inference 5.997–9.300 s (5 runs). T44 runs one
# sidecar process per file, so the load is paid on every invocation.
# APP_GIGAAM_WORKER_TIMEOUT_S=1800

# --- Docker / Compose (Task 17) ---
# docker-compose.yml forwards this file into the containers (if present) and
# interpolates APP_UID/APP_GID from it. The containers run as a non-root user
# whose UID/GID must be able to write the bind-mounted ./data directory.
# The image default is 1000:1000 — the standard first WSL 2 user. Change only
# when `id -u` / `id -g` report something else (see README, "Docker" section).
# APP_UID=1000
# APP_GID=1000

